{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buybound.local/schemas/guardian-policy.schema.json",
  "title": "BuyBound Guardian Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mandateId",
    "version",
    "currency",
    "maxUnitPrice",
    "maxTotal",
    "maxQuantity",
    "allowedMerchantIds",
    "maxPurchasesPerDay",
    "offerMaxAgeSeconds",
    "newMerchantBehavior"
  ],
  "properties": {
    "mandateId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "maxUnitPrice": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
    },
    "maxTotal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
    },
    "maxQuantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "allowedMerchantIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxPurchasesPerDay": {
      "type": "integer",
      "minimum": 0
    },
    "offerMaxAgeSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "newMerchantBehavior": {
      "type": "string",
      "enum": [
        "HOLD",
        "BLOCK"
      ]
    },
    "requireHumanApprovalAbove": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
    },
    "allowedCategories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "maxWeeklySpend": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
    }
  }
}
