# Copy to .env for local development. Never commit real values.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/buybound
DATABASE_USERNAME=buybound
DATABASE_PASSWORD=change_me_locally

# Channel3 Live Product Catalog & Price Intelligence
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1

# AI Shopping & Forensics Agent (supports: groq, openai, gemini)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# PayPal Developer Sandbox (Never enable live-money execution in MVP)
PAYPAL_MODE=sandbox
PAYMENTS_MODE=sandbox
DISCOVERY_MODE=channel3
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ORIGINS=http://localhost:5173
